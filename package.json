{
  "name": "@micahcraig/ebbets",
  "version": "0.1.1",
  "description": "Softball lineup manager — drag-and-drop lineup and field position assignment",
  "author": "Micah Craig",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "dev": "vite",
    "build:app": "vite build",
    "build": "vite build --config vite.config.lib.js",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/react": "^7.6.24",
    "@storybook/react-vite": "^7.6.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.6.24",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^4.0.0",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
